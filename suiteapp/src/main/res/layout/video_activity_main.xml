<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#081426"
    android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Video Kareleri" android:textColor="#F4C430" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="İstediğin klasörleri ekle, içlerindeki videoları toplu seç ve her saniyeden 1 kare çıkar."
        android:textColor="#D9E2F2" android:textSize="14sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <Button android:id="@+id/btnFolder" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Klasör ekle" />
        <Button android:id="@+id/btnClearFolders" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Klasörleri temizle" />
    </LinearLayout>

    <TextView android:id="@+id/txtFolders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Seçili klasör yok" android:textColor="#FFFFFF" android:textSize="13sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnAll" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tümünü seç" />
        <Button android:id="@+id/btnNone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Seçimi temizle" />
    </LinearLayout>

    <TextView android:id="@+id/txtCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0 video" android:textColor="#F4C430" android:textStyle="bold" />
    <ListView android:id="@+id/listVideos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:choiceMode="multipleChoice" android:divider="#243B5A" android:dividerHeight="1dp" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="0" />
    <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hazır" android:textColor="#FFFFFF" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Başlat" />
        <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:enabled="false" android:text="Durdur" />
    </LinearLayout>
</LinearLayout>
