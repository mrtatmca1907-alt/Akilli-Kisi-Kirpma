<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071A52"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCREENSHOT"
            android:textColor="#FFD21F"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Akıllı kişi kırpma • Yaş filtresiz"
            android:textColor="#C9D4F4"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#122D6B"
            android:padding="16dp"
            android:text="Fotoğraf seç veya klasör ekle. Uygulama klasörlerin altını da tarar; algılanan her kişiyi ayrı yüksek kaliteli JPG olarak kaydeder. Orijinallere dokunmaz."
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#173A7D"
            android:text="Fotoğrafları seç"
            android:textAllCaps="false"
            android:textColor="#FFD21F"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#173A7D"
            android:text="Klasör ekle"
            android:textAllCaps="false"
            android:textColor="#FFD21F"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#173A7D"
            android:text="Seçimleri temizle"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txtSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#122D6B"
            android:padding="16dp"
            android:text="Henüz seçim yok"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#FFD21F"
            android:text="Kırpmayı başlat"
            android:textAllCaps="false"
            android:textColor="#071A52"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#8B1D30"
            android:enabled="false"
            android:text="Durdur"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="20dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FFD21F"
            android:progressBackgroundTint="#31539A" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hazır"
            android:textColor="#FFD21F"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#122D6B"
            android:padding="16dp"
            android:text="İşlenen 0 • Algılanan 0 • Kaydedilen 0 • Hata 0"
            android:textColor="#D9E2F2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Çıktı: Pictures/Screenshot/orijinal-dosya-adi/\nİşlem arka planda devam eder; bildirimden durum ve durdurma kullanılabilir."
            android:textColor="#9FB4E4"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
